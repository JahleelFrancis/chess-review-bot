# Default: normalize text to LF in the repo
* text=auto eol=lf

# Markdown + text explicitly
*.md text eol=lf
*.txt text eol=lf

# Images are binary (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary

# Exclude third-party engine and browser vendor source from GitHub language statistics.
# These directives do not delete files or affect their execution.
stockfish/** linguist-vendored
static/vendor/** linguist-vendored
