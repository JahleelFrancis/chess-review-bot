# Default: normalize text to LF in the repo
* text=auto eol=lf

# Markdown + text explicitly
*.md text eol=lf
*.txt text eol=lf

# Images are binary (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary

# Stockfish is an external chess engine, not application-authored C++.
# Exclude its source and build scripts from GitHub's language percentages.
stockfish/** linguist-vendored

# Browser libraries shipped with the app are third-party dependencies.
static/vendor/** linguist-vendored

